@model ToDo.Web.Models.HomeIndexVm
@{
    ViewData["Title"] = "Gösterge Paneli";
}

<div class="row g-3">
    <!-- Kartlar -->
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Aktif Görevlerim</div>
                        <div class="fs-4 fw-semibold">@ViewBag.MyActive</div>
                    </div>
                    <div class="rounded-circle bg-primary-subtle p-3"><i class="bi bi-list-check"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Geciken</div>
                        <div class="fs-4 fw-semibold text-danger">@ViewBag.Overdue</div>
                    </div>
                    <div class="rounded-circle bg-danger-subtle p-3"><i class="bi bi-alarm"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Bugün</div>
                        <div class="fs-4 fw-semibold">@ViewBag.Today</div>
                    </div>
                    <div class="rounded-circle bg-warning-subtle p-3"><i class="bi bi-calendar-day"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Tamamlanan</div>
                        <div class="fs-4 fw-semibold text-success">@ViewBag.Done</div>
                    </div>
                    <div class="rounded-circle bg-success-subtle p-3"><i class="bi bi-check2-circle"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Örnek tablo alanı -->
<div class="card mt-4 shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Son Bildirimler</h6>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Notifications" asp-action="Index">Tümü</a>
    </div>  
    <div class="card-body">
        <div class="text-muted">

            <!-- — Son 5 Bildirim — -->
            @if (User.Identity?.IsAuthenticated == true)
            {

                    <ul class="list-group list-group-flush">
                        @if (Model?.Last5Notifications?.Count > 0)
                        {
                            @foreach (var n in Model.Last5Notifications)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="me-3">
                                        <div class="fw-semibold">
                                            @if (!string.IsNullOrWhiteSpace(n.Url))
                                            {
                                                <a href="/Notifications/Details/@n.Id">@n.Title</a>
                                            }
                                            else
                                            {

                                                @n.Title
                                            }

                                            @if (!n.IsRead)
                                            {
                                                <span class="badge bg-primary ms-2">Yeni</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(n.Body))
                                        {
                                            <div class="text-muted small">@n.Body</div>
                                        }

                                        <div class="text-muted small">@n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-muted">Şimdilik bildirim yok.</li>
                        }
                    </ul>
                
            }


    </div>
</div>

